# 刃影 / RenYing .gitignore
#
# What belongs in the repository: the sources (src/, assets/, cloudflare/, tools/, docs/, models/),
# the generated pages that GitHub Pages serves (index.html, renying-offline.html, renying.html),
# and the top-level docs. Everything a test, an audit or a local run writes stays out.
#
# CI also requires every tracked file name to be lowercase (see .github/workflows/ci.yml).

# ------------------------------------------------------------------------------
# 1. Operating system files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
Icon?
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 2. Editors and local assistant state
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.xcuserdatad/
xcuserdata/
*.xcuserstate
.claude/

# ------------------------------------------------------------------------------
# 3. Build products and caches
#    The pages at the root are generated by tools/build.py but ARE committed.
# ------------------------------------------------------------------------------
build/
dist/
DerivedData/
.build/
_site/
node_modules/
.npm/
*.pyc
__pycache__/
*.egg-info/
.wrangler/
cloudflare/.wrangler/
*.zip
*.tar.gz
tools/music/out/

# ------------------------------------------------------------------------------
# 4. Test and audit output
#    tools/*-audit.mjs and tools/*-test.mjs write screenshots and logs into these folders.
# ------------------------------------------------------------------------------
ci-ui/
ci-hud/
ci-hud-ov/
ci-touch/
ci-net/
ci-perf/
ci-firstload/
ci-kb/
ci-*/
# Screenshots dropped at the repository root by local runs (real images live in assets/ or docs/)
/*.png
/*.jpg
/*.jpeg
/*.webp

# ------------------------------------------------------------------------------
# 5. Secrets, local data and logs
#    Never commit Worker secrets, D1 exports (they contain accounts and password hashes)
#    or anything from a local database. See docs/deploy-runbook.md.
# ------------------------------------------------------------------------------
.env
.env.*
.dev.vars
*service-account*.json
*serviceAccount*.json
*.pem
*.key
*.p12
backup-*.sql
*.db
*.sqlite
*.sqlite3
*.log
models/*.txt
models/*.log
data/
!src/data/
logs/
scratch/
tmp/
.local/
