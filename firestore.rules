rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID)
    // Fields:
    //   - name: string (required, 1-24 characters) - Player display name
    //   - ink: int or float (required, >= 0) - In-game ink currency
    //   - owned: list of strings (required, 1-50 items) - Unlocked character IDs (e.g. 'qingfeng', 'tieshan')
    //   - frags: map of character ID to int/float (required, <= 50 keys) - Character fragment counts
    //   - pity: int or float (required, >= 0) - Character gacha pity counter
    //   - spity: int or float (required, >= 0) - Skin gacha pity counter
    //   - skins: list of strings (required, <= 100 items) - Unlocked skin keys
    //   - equip: map of character ID to string (required, <= 50 keys) - Equipped skin per character
    //   - netWins: int or float (required, >= 0) - P2P/online match wins count
    //   - netLosses: int or float (required, >= 0) - P2P/online match losses count
    //   - online10Unlocked: bool (required) - Online 10-win reward milestone flag
    //   - stageStars: map of stage ID to int/float (required, <= 200 keys) - Stage stars count (1-3)
    //   - qfx: int or float (required, >= 0) - Event/Qingfengxing counter
    //   - updatedAt: timestamp or int or float (required, >= 0) - Last save/sync timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if the authenticated user has administrative privileges or master dev bypass
    function isSuperUser() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == 'dev_master' ||
        request.auth.token.email == 'ry_dev@renying.game'
      );
    }

    // Check if the authenticated user has administrative privileges
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.uid == 'ry_admin_master'
      );
    }

    // Allowed profile fields whitelist
    function allowedProfileFields() {
      return [
        'name', 'ink', 'owned', 'frags', 'pity', 'spity', 'skins',
        'equip', 'netWins', 'netLosses', 'online10Unlocked',
        'stageStars', 'qfx', 'updatedAt'
      ];
    }

    // Optional fields: may be missing on older profiles
    //   - rk: map (<= 20 keys) - Ranked season state (season, pts, placed, est, w, l, peak, streak, hist, pending, at, owner, last)
    function optionalProfileFields() {
      return ['rk'];
    }

    // Enforce strict schema: no arbitrary or extraneous fields allowed
    function hasOnlyAllowedFields() {
      return request.resource.data.keys().hasOnly(allowedProfileFields().concat(optionalProfileFields()));
    }

    // Validate ranked state map when present
    function isValidRanked(data) {
      return !('rk' in data) || (data.rk is map && data.rk.keys().size() <= 20);
    }

    // Validate that all required fields are present in the document
    function hasRequiredFields() {
      return request.resource.data.keys().hasAll(allowedProfileFields());
    }

    // Validate non-negative numbers with DoS/overflow upper bounds
    function isNonNegativeNum(val) {
      return (val is int || val is float) && val >= 0 && val <= 1000000000;
    }

    // Validate player nickname
    function isValidName(name) {
      return name is string && name.size() >= 1 && name.size() <= 24;
    }

    // Validate owned character ID list
    function isValidOwned(owned) {
      return owned is list && owned.size() >= 1 && owned.size() <= 50;
    }

    // Validate fragments map
    function isValidFrags(frags) {
      return frags is map && frags.keys().size() <= 50;
    }

    // Validate skins key list
    function isValidSkins(skins) {
      return skins is list && skins.size() <= 100;
    }

    // Validate equipped skins map
    function isValidEquip(equip) {
      return equip is map && equip.keys().size() <= 50;
    }

    // Validate stage star records map
    function isValidStageStars(stageStars) {
      return stageStars is map && stageStars.keys().size() <= 200;
    }

    // Validate update timestamp (supports Firestore timestamp, integer epoch, or float epoch)
    function isValidUpdatedAt(val) {
      return val is timestamp || ((val is int || val is float) && val >= 0);
    }

    // Validate starter resource limits for regular player account creation (allows guest progression carryover)
    function isValidStarterProfile(data) {
      return isSuperUser() || (
        data.ink <= 10000 &&
        data.owned.size() <= 9 &&
        data.skins.size() <= 5 &&
        data.netWins <= 50
      );
    }

    // Anti-tampering and progression rate-limit validator for profile updates
    function isValidProfileProgression(prev, next) {
      return isSuperUser() || (
        next.ink <= prev.ink + 5000 &&
        next.owned.size() <= prev.owned.size() + 10 &&
        next.skins.size() <= prev.skins.size() + 10 &&
        next.netWins <= prev.netWins + 20
      );
    }

    // ===============================================================
    // Domain Validator (Used in both create and update to prevent Update Bypass)
    // ===============================================================

    function isValidUserProfile(data) {
      return hasOnlyAllowedFields() &&
             hasRequiredFields() &&
             isValidName(data.name) &&
             isNonNegativeNum(data.ink) &&
             isValidOwned(data.owned) &&
             isValidFrags(data.frags) &&
             isNonNegativeNum(data.pity) &&
             isNonNegativeNum(data.spity) &&
             isValidSkins(data.skins) &&
             isValidEquip(data.equip) &&
             isNonNegativeNum(data.netWins) &&
             isNonNegativeNum(data.netLosses) &&
             data.online10Unlocked is bool &&
             isValidStageStars(data.stageStars) &&
             isNonNegativeNum(data.qfx) &&
             isValidRanked(data) &&
             isValidUpdatedAt(data.updatedAt);
    }

    // ===============================================================
    // Anti-cheat sanctions: sanctions/{userId}
    // ===============================================================
    //   - strikes: int (1-100) - times caught cheating
    //   - banUntil: int (epoch ms) - temporary ban end (24h on the 2nd strike)
    //   - perm: bool - permanent ban (3rd strike)
    //   - log: list (<= 20) - { r: reason, at: epoch ms }
    //   - at: int - last change; pardon: int - set by an admin when unbanning; name: string
    // A player's own client may only make the record heavier: one more strike per write,
    // ban never shortened, permanent never lifted. Only admins can pardon or delete.

    function isValidSanction(d) {
      return d.keys().hasOnly(['strikes', 'banUntil', 'perm', 'log', 'at', 'pardon', 'name']) &&
             d.strikes is int && d.strikes >= 1 && d.strikes <= 100 &&
             (d.banUntil is int || d.banUntil is float) && d.banUntil >= 0 &&
             d.perm is bool &&
             d.log is list && d.log.size() <= 20 &&
             (d.strikes < 2 || d.banUntil >= request.time.toMillis() + 23 * 3600 * 1000 || ('banUntil' in resource.data && d.banUntil == resource.data.banUntil)) &&
             (d.strikes < 3 || d.perm == true);
    }

    // Profile writes are refused while the account is banned
    function notBanned(userId) {
      let p = /databases/$(database)/documents/sanctions/$(userId);
      return isSuperUser() || !exists(p) ||
             (get(p).data.perm != true && get(p).data.banUntil < request.time.toMillis());
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // Root collection: users/{userId}
    match /users/{userId} {
      // Only the authenticated account owner or admin/superuser can read their profile
      allow read: if isOwner(userId) || isSuperUser();

      // Creation: must be valid schema and meet starter limits unless admin/superuser
      allow create: if (isOwner(userId) || isSuperUser()) &&
                       notBanned(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       isValidStarterProfile(request.resource.data);

      // Update: must be valid schema and adhere to anti-tampering progression bounds unless admin/superuser
      allow update: if (isOwner(userId) || isSuperUser()) &&
                       notBanned(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       isValidProfileProgression(resource.data, request.resource.data);

      // Deletion: owner or admin/superuser only
      allow delete: if isOwner(userId) || isSuperUser();
    }

    match /sanctions/{userId} {
      allow read: if isOwner(userId) || isSuperUser();
      allow create: if isSuperUser() ||
                       (isOwner(userId) && request.resource.data.strikes == 1 && isValidSanction(request.resource.data));
      allow update: if isSuperUser() ||
                       (isOwner(userId) && isValidSanction(request.resource.data) &&
                        request.resource.data.strikes == resource.data.strikes + 1 &&
                        request.resource.data.banUntil >= resource.data.banUntil &&
                        (resource.data.perm != true || request.resource.data.perm == true) &&
                        request.resource.data.get('pardon', 0) == resource.data.get('pardon', 0));
      allow delete: if isSuperUser();
    }

    // Default Deny: Deny all reads and writes to any unspecified path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
